# Copy to ~/funtrade/.env on the Pi and fill in. chmod 600. Never commit the real file.
# IBKR PAPER account login (Client Portal -> Settings -> Paper Trading Account).
TWS_USERID=
TWS_PASSWORD=
# Optional: set to enable VNC on 127.0.0.1:5900 (ssh -L 5900:localhost:5900 to view the Gateway).
VNC_SERVER_PASSWORD=
# Managed by deploy.sh: the image tags (git shas) currently deployed.
FUNTRADE_TAG=
DASHBOARD_TAG=
